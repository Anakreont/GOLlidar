# Skopiuj do sync.conf i uzupelnij. Plik sync.conf nie trafia do repozytorium.

# --- Wariant A (zalecany): wysylka przez HTTPS do BMS API (endpoint z serwer/lidar_upload.py)
URL="https://adres-api"
TOKEN="tu-wklej-LIDAR_TOKEN"

# --- Wariant B: rsync przez SSH (uzywany, gdy URL jest pusty)
